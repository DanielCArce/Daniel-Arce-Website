---
import SocialWidget from "./SocialWidget.astro";
---
<footer class="relative bg-slate-950 pt-24 pb-8 overflow-hidden">

<!-- TOP ACCENT -->

<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-emerald-500/60 to-transparent"></div>


<div class="max-w-7xl mx-auto px-4 sm:px-6">


    <!-- MAIN -->

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 pb-20">


        <!-- BRAND -->

        <div class="lg:col-span-6">

            <a
                href="/"
                class="inline-flex items-center gap-3 group"
                aria-label="Daniel Arce - Inicio"
            >

                <div
                    class="w-11 h-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-xl transition-all duration-300 group-hover:bg-white group-hover:text-emerald-600"
                >
                    D
                </div>

                <span class="text-2xl font-extrabold tracking-tight text-white">
                    Daniel<span class="text-emerald-500">Arce</span>
                </span>

            </a>


            <div class="mt-8 max-w-xl">

                <p class="text-2xl md:text-3xl font-bold text-white leading-tight tracking-tight">
                    Tecnología y finanzas para
                    <span class="text-emerald-500">
                        empresas que quieren operar mejor.
                    </span>
                </p>


                <p class="mt-6 text-base text-slate-400 leading-relaxed max-w-lg">
                    Desarrollo software, automatizo procesos y gestiono
                    información financiera para convertir la complejidad
                    operativa en mayor control y eficiencia.
                </p>

            </div>


            <div class="mt-8">
                <SocialWidget />
            </div>

        </div>


        <!-- NAVIGATION -->

        <div class="lg:col-span-2">

            <div class="flex items-center gap-3 mb-6">

                <span class="w-6 h-px bg-emerald-500"></span>

                <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300">
                    Explorar
                </h2>

            </div>


            <ul class="space-y-4 text-sm">

                <li>
                    <a
                        href="/"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Inicio
                    </a>
                </li>

                <li>
                    <a
                        href="/#servicios"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Servicios
                    </a>
                </li>

                <li>
                    <a
                        href="/blog/"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Blog
                    </a>
                </li>

                <li>
                    <a
                        href="/#contacto"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Contacto
                    </a>
                </li>

            </ul>

        </div>


        <!-- SERVICES -->

        <div class="lg:col-span-2">

            <div class="flex items-center gap-3 mb-6">

                <span class="w-6 h-px bg-emerald-500"></span>

                <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300">
                    Servicios
                </h2>

            </div>


            <ul class="space-y-4 text-sm">

                <li>
                    <a
                        href="/#servicios"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Software Empresarial
                    </a>
                </li>

                <li>
                    <a
                        href="/#servicios"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Automatización
                    </a>
                </li>

                <li>
                    <a
                        href="/#servicios"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Integración de Sistemas
                    </a>
                </li>

                <li>
                    <a
                        href="/#servicios"
                        class="text-slate-400 hover:text-white transition-colors"
                    >
                        Finanzas & Contabilidad
                    </a>
                </li>

            </ul>

        </div>


        <!-- CTA -->

        <div class="lg:col-span-2">

            <div class="flex items-center gap-3 mb-6">

                <span class="w-6 h-px bg-emerald-500"></span>

                <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-300">
                    Hablemos
                </h2>

            </div>


            <p class="text-sm text-slate-400 leading-relaxed mb-6">
                Cuéntame qué quieres mejorar y revisemos dónde la
                tecnología, la automatización o las finanzas pueden
                generar un impacto real.
            </p>


            <a
                href="/#contacto"
                class="group inline-flex items-center justify-between gap-6 w-full px-5 py-4 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-500 transition-all duration-300"
            >

                <span>
                    Agendar diagnóstico
                </span>

                <span class="text-lg transition-transform duration-300 group-hover:translate-x-1">
                    →
                </span>

            </a>

        </div>

    </div>


    <!-- BOTTOM -->

    <div
        class="pt-7 border-t border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-5"
    >

        <div class="flex flex-col gap-1">

            <p class="text-xs text-slate-500">
                © {new Date().getFullYear()} Daniel Campos Arce
            </p>

            <p class="text-[10px] text-slate-600 uppercase tracking-[0.16em]">
                Tecnología · Finanzas · Automatización
            </p>

        </div>


        <div class="flex items-center gap-6 text-xs">

            <a
                href="/blog/"
                class="text-slate-500 hover:text-emerald-500 transition-colors"
            >
                Blog
            </a>

            <a
                href="/#contacto"
                class="text-slate-500 hover:text-emerald-500 transition-colors"
            >
                Contacto
            </a>

        </div>

    </div>

</div>

</footer>