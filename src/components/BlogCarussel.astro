---
import { getCollection } from "astro:content";
const {limit} = Astro.props;

const posts = await getCollection("blog").then((collection) => {
        let result = collection.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
        if(limit != null){
            return result.slice(0,limit);
        }
        return result;
    });
---
<section class="w-full py-24 md:py-32 bg-white" id="blog">

<div class="max-w-7xl mx-auto px-4 sm:px-6">


    <!-- HEADER -->

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">

        <div class="max-w-3xl">

            <div class="flex items-center gap-3 mb-5">

                <span class="w-8 h-px bg-emerald-500"></span>

                <span class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">
                    Blog
                </span>

            </div>


            <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.05]">

                Tecnología, finanzas
                <span class="block text-slate-400">
                    y negocios.
                </span>

            </h2>


            <p class="mt-6 text-lg text-slate-500 max-w-2xl leading-relaxed">
                Análisis, ideas y conocimiento práctico para entender mejor
                la tecnología y las finanzas de tu empresa.
            </p>

        </div>


        <a
            href="/blog/"
            class="hidden md:flex items-center gap-3 text-sm font-bold text-slate-900 group"
        >

            Ver todos los artículos

            <span class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center group-hover:border-slate-900 group-hover:translate-x-1 transition-all">
                →
            </span>

        </a>

    </div>


    <!-- MASONRY -->

    <div class="masonry">

        {
            posts.map((post, index) => (

                <article
                    class:list={[
                        "masonry-item",
                        "group",
                        "relative",
                        "bg-white",
                        "border",
                        "border-slate-200",
                        "rounded-2xl",
                        "overflow-hidden",
                        "transition-all",
                        "duration-300",
                        "hover:border-slate-300",
                        "hover:shadow-lg",
                        index === 0 && "featured",
                    ]}
                >

                    <a
                        href={`/blog/${post.data.slug}/`}
                        class="block p-7 md:p-8"
                    >

                        <!-- META -->

                        <div class="flex items-center justify-between gap-4 mb-7">

                            <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-600">
                                {post.data.category || "Artículo"}
                            </span>

                            <time class="text-[11px] text-slate-400">
                                {new Date(post.data.date).toLocaleDateString("es-ES", {
                                    year: "numeric",
                                    month: "short",
                                    day: "numeric",
                                })}
                            </time>

                        </div>


                        <!-- TITLE -->

                        <h3
                            class:list={[
                                "font-bold text-slate-900 leading-tight tracking-tight group-hover:text-emerald-600 transition-colors",
                                index === 0
                                    ? "text-3xl md:text-4xl"
                                    : "text-xl md:text-2xl",
                            ]}
                        >
                            {post.data.title}
                        </h3>


                        <!-- DESCRIPTION -->

                        {
                            post.data.description && (
                                <p
                                    class:list={[
                                        "text-slate-500 leading-relaxed",
                                        index === 0
                                            ? "text-base mt-6 line-clamp-5"
                                            : "text-sm mt-5 line-clamp-4",
                                    ]}
                                >
                                    {post.data.description}
                                </p>
                            )
                        }


                        <!-- FOOTER -->

                        <div
                            class:list={[
                                "flex items-center justify-between border-t border-slate-100",
                                index === 0
                                    ? "mt-10 pt-6"
                                    : "mt-8 pt-5",
                            ]}
                        >

                            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 group-hover:text-emerald-600 transition-colors">
                                Leer artículo
                            </span>


                            <span class="text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-1 transition-all">
                                →
                            </span>

                        </div>

                    </a>

                </article>

            ))
        }

    </div>


    <!-- BOTTOM -->

    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">

        <p class="text-sm text-slate-500">
            Ideas sobre tecnología, automatización y gestión empresarial.
        </p>

        <a
            href="/blog/"
            class="text-sm font-bold text-slate-900 hover:text-emerald-600 transition-colors"
        >
            Explorar el blog →
        </a>

    </div>


    <!-- MOBILE -->

    <div class="mt-8 md:hidden">

        <a
            href="/blog/"
            class="flex items-center justify-center w-full px-6 py-4 bg-slate-900 text-white rounded-xl font-bold"
        >
            Ver todos los artículos
        </a>

    </div>

</div>

</section>

<style> .masonry { columns: 1; column-gap: 1.5rem; } .masonry-item { break-inside: avoid; margin-bottom: 1.5rem; } @media (min-width: 768px) { .masonry { columns: 2; } } @media (min-width: 1100px) { .masonry { columns: 3; } .featured { margin-bottom: 1.5rem; } } </style>