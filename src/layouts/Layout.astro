    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.danielcarce.com/#service",
      "name": "Daniel Software & Finance",
      "alternateName": [
        "Daniel Arce - Consultoría Tecnológica y Contable",
        "Daniel Arce Software & Contabilidad"
      ],
      "url": "https://www.danielcarce.com",
      "image": "https://danielcarce.com/og-image.png",
      "logo": "https://www.danielcarce.com/favicon-32x32.png", 
      "telephone": ["+50664857937", "+50686813736"],
      "priceRange": "$$",
      "founder": { 
        "@id": "https://www.danielcarce.com/#person" 
      },
      "sameAs": [
        "https://www.google.com/search?kgmid=%2Fg%2F11zx4vyp7n"
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "@id": "https://www.danielcarce.com/#whatsapp",
          "telephone": "+50664857937",
          "contactType": "WhatsApp",
          "availableLanguage": ["Spanish", "English"]
        },
        {
          "@type": "ContactPoint",
          "@id": "https://www.danielcarce.com/#phone",
          "telephone": "+50686813736",
          "contactType": "customer service",
          "description": "Llamadas telefónicas",
          "availableLanguage": ["Spanish", "English"]
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Heredia centro",
        "addressLocality": "Heredia",
        "addressRegion": "Heredia",
        "postalCode": "40101",
        "addressCountry": "CR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 9.9988,
        "longitude": -84.1165
      },
      "areaServed": {
        "@type": "Country",
        "name": "Costa Rica"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "09:00",
        "closes": "17:00"
      },
      "offers": [
        {
          "@type": "Service",
          "name": "Fractional CFO y Análisis Financieros",
          "description": "Dirección financiera externa, análisis financieros profundos, control de presupuestos y toma de decisiones gerenciales basadas en datos."
        },
        {
          "@type": "Service",
          "name": "Planificación de Impuestos y Contabilidad",
          "description": "Estrategia fiscal, cumplimiento tributario adaptado a Costa Rica y análisis contables rigurosos para PYMES."
        },
        {
          "@type": "Service",
          "name": "Revisiones de Infraestructura Tecnológica",
          "description": "Auditoría y evaluación de arquitecturas de software, sistemas y servidores para garantizar seguridad, escalabilidad y eficiencia."
        },
        {
          "@type": "Service",
          "name": "Desarrollo de Software y Automatización (BPA)",
          "description": "Creación de aplicaciones a medida, sistemas web/cloud y automatización de procesos operativos para negocios."
        }
      ]
    }
  ]
