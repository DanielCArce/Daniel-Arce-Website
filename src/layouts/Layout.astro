---
import PageHeader from "../components/PageHeader.astro";
import FooterSection from "../components/FooterSection.astro";

// Dentro de tu Layout de Astro
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.danielcarce.com/#person",
      "name": "Daniel Arce",
      "url": "https://www.danielcarce.com",
      "jobTitle": [
        "Senior Software Engineer",
        "Contador Privado",
        "Private Accountant",
        "Fractional CFO",
        "Desarrollador de Software",
        "Consultor Tecnológico y Financiero",
        "Arquitecto de Software"
      ],
      "description": "Consultor integral y Fractional CFO para PYMES en Costa Rica. Experto en la intersección de infraestructura tecnológica avanzada, desarrollo de software y precisión financiera y contable.",
      "sameAs": [
        "https://www.linkedin.com/in/danielcarce",
        "https://www.instagram.com/30thopps"
      ],
      "knowsAbout": [
        "Fractional CFO",
        "Planificación de Impuestos",
        "Presupuestos y Control Financiero",
        "Análisis Financieros",
        "Análisis Contables",
        "Revisiones de Infraestructura Tecnológica",
        "Desarrollo de Software a Medida",
        "Desarrollo de Aplicaciones Móviles y Web",
        "Sistemas de Escritorio y Cloud",
        "Integración de Sistemas y APIs",
        "Automatización de Procesos (BPA)",
        "Optimización de Flujos de Trabajo",
